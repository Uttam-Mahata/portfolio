{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blogs",
        "destination": "/blogs/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "!/blogs{,/**}",
        "destination": "/index.html"
      }
    ]
  }
}
